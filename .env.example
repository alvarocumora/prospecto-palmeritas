# Variables de entorno — copiar a .env para desarrollo local o definir en deploy.
#
# VITE_SUPABASE_URL / VITE_SUPABASE_PUBLISHABLE_KEY son PÚBLICAS por diseño.
# La app incluye un fallback público versionado para que preview/deploy no pierda auth si
# estas variables no fueron inyectadas. Puedes sobreescribirlas por entorno.
#
# Los secretos REALES (especialmente SUPABASE_SERVICE_ROLE_KEY) NUNCA se versionan.
# Deben existir únicamente en el entorno seguro del servidor/deploy.
SUPABASE_PROJECT_ID=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=
