# Variables de entorno — COPIAR a .env (no versionar) o definir en el entorno de deploy.
# Estas VITE_* son PÚBLICAS por diseño (se envían al navegador; la seguridad la da RLS).
# Los secretos REALES (p.ej. SUPABASE_SERVICE_ROLE_KEY) NUNCA van aquí ni en .env versionado:
# se definen solo en el entorno de deploy / GitHub Secrets.
SUPABASE_PROJECT_ID=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=
